024-10-15T03:34:56Z","timestamp":1728963296000},"score":25.051113,"resource":{"primary":{"URL":"https:\/\/peerj.com\/articles\/cs-2391\/fig-1"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.2391\/fig-1","relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.2391","asserted-by":"object"}]}},{"institution":[{"name":"West Virginia University Libraries","acronym":["wvul"],"department":["Civil and Environmental Engineering"]}],"indexed":{"date-parts":[[2023,12,20]],"date-time":"2023-12-20T00:38:18Z","timestamp":1703032698593},"reference-count":0,"publisher":"West Virginia University Libraries","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.33915\/etd.12184","type":"dissertation","created":{"date-parts":[[2023,12,19]],"date-time":"2023-12-19T19:58:57Z","timestamp":1703015937000},"approved":{"date-parts":[[2023,1,1]]},"source":"Crossref","is-referenced-by-count":0,"title":["Spatial Analysis of Bike-Sharing Station Usage and Placement: Redefining Bike-Share Planning for Equity"],"prefix":"10.33915","author":[{"given":"Sydney E","family":"French","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"19638","deposited":{"date-parts":[[2023,12,19]],"date-time":"2023-12-19T19:59:30Z","timestamp":1703015970000},"score":25.023916,"degree":["MS"],"resource":{"primary":{"URL":"https:\/\/researchrepository.wvu.edu\/etd\/12184"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.33915\/etd.12184"},{"institution":[{"name":"Research Square"}],"indexed":{"date-parts":[[2023,10,30]],"date-time":"2023-10-30T09:50:49Z","timestamp":1698659449763},"posted":{"date-parts":[[2023,8,31]]},"group-title":"In Review","reference-count":0,"publisher":"Research Square Platform LLC","license":[{"start":{"date-parts":[[2023,8,31]],"date-time":"2023-08-31T00:00:00Z","timestamp":1693440000000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0\/"}],"content-domain":{"domain":[],"crossmark-restriction":false},"accepted":{"date-parts":[[2023,8,28]]},"abstract":"<jats:title>Abstract<\/jats:title>\n        <jats:p>The effect of newly introduced bike stations on bike-share systems at the system, community, and station levels is investigated in this study. Changes in the topological properties of a bike-share traffic network and its subnetworks defined through community detection are examined using a network analysis methodology that has been relatively underexplored in previous studies despite its significance and utility. Centrality and network flow measures are employed to assess the effects of new bike stations on both individual stations and communities. The findings reveal that introducing new bike stations significantly enhances station connectivity and overall bike usage. However, the impact varies across communities and existing bike stations; notably, spatial relationships with preexisting stations tend to diminish the influence of new stations. This study also establishes a correlation between the utilization of new bike stations and the centrality and network flow of existing neighboring stations.<\/jats:p>","DOI":"10.21203\/rs.3.rs-3303152\/v1","type":"posted-content","created":{"date-parts":[[2023,8,31]],"date-time":"2023-08-31T06:27:01Z","timestamp":1693463221000},"source":"Crossref","is-referenced-by-count":0,"title":["Investigation on the impact of new bike stations on a bike-share system based on a complex bike-sharing network"],"prefix":"10.21203","author":[{"given":"Kyoungok","family":"Kim","sequence":"first","affiliation":[{"name":"Seoul National University of Science & Technology (SeoulTech)"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"8761","link":[{"URL":"https:\/\/www.researchsquare.com\/article\/rs-3303152\/v1","content-type":"text\/html","content-version":"vor","intended-application":"text-mining"},{"U