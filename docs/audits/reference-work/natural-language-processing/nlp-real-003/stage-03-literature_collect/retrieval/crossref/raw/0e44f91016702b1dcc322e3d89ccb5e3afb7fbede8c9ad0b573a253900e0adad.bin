[{"role":"author","vocabulary":"crossref"}]}],"member":"9949","deposited":{"date-parts":[[2020,6,10]],"date-time":"2020-06-10T17:08:45Z","timestamp":1591808925000},"score":29.534203,"resource":{"primary":{"URL":"https:\/\/digitalcommons.uri.edu\/theses\/1281"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.23860\/thesis-li-na-2018"},{"indexed":{"date-parts":[[2025,2,14]],"date-time":"2025-02-14T04:10:02Z","timestamp":1739506202787,"version":"3.37.0"},"reference-count":0,"publisher":"ISROSET: International Scientific Research Organization for Science, Engineering and Technology","issue":"1","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["ijcse"],"DOI":"10.26438\/ijcse\/v10i1.1823","type":"journal-article","created":{"date-parts":[[2022,4,3]],"date-time":"2022-04-03T04:20:31Z","timestamp":1648959631000},"page":"18-23","source":"Crossref","is-referenced-by-count":0,"title":["IMDb Movie Data Classification using Voting Classifier for Sentiment Analysis"],"prefix":"10.26438","volume":"10","author":[{"given":"Karishma","family":"Kaushik","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Mahesh","family":"Parmar","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"10981","published-online":{"date-parts":[[2022,1,31]]},"container-title":["International Journal of Computer Sciences and Engineering"],"deposited":{"date-parts":[[2025,2,14]],"date-time":"2025-02-14T03:33:35Z","timestamp":1739504015000},"score":29.186386,"resource":{"primary":{"URL":"http:\/\/www.ijcseonline.org\/full_paper_view.php?paper_id=5431"}},"issued":{"date-parts":[[2022,1,31]]},"references-count":0,"journal-issue":{"issue":"1","published-online":{"date-parts":[[2022,1,31]]}},"URL":"https:\/\/doi.org\/10.26438\/ijcse\/v10i1.1823","ISSN":["2347-2693"],"issn-type":[{"type":"electronic","value":"2347-2693"}],"published":{"date-parts":[[2022,1,31]]}},{"indexed":{"date-parts":[[2026,1,31]],"date-time":"2026-01-31T14:44:07Z","timestamp":1769870647913,"version":"3.49.0"},"reference-count":0,"publisher":"Darcy & Roy Press Co. Ltd.","issue":"2","license":[{"start":{"date-parts":[[2026,1,29]],"date-time":"2026-01-29T00:00:00Z","timestamp":1769644800000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["AJST"],"abstract":"<jats:p>Sentiment analysis of user reviews is a core Natural Language Processing (NLP) task with practical uses in real scenarios like recommendation. However, the traditional approach like training neural networks models such as CNN, RNN, and LSTM, has faced challenges in improving recognition accuracy. With the development of Language Models (LM) with their self-attention mechanism for contextual understanding, this research wants to see if Language Models exceed Neural Networks on this task. This study conducts a controlled comparison on the IMDb Large Movie Review Dataset (50K reviews) for binary sentiment classification of long movie reviews. The evaluation of four models is based on the dataset that has been cleaned with max sequence length 256, and a stratified 8:1:1 train\/validation\/test split with multi-seeds. On the IMDb test set, TextCNN performs with an accuracy of 0.873, LSTM reaches 0.862, while DistilBERT achieves 0.911, consistently outperforming strong CNN\/LSTM baselines by about 4%. In addition, an accuracy and latency trade-off is observed: DistilBERT offers the best quality with moderate runtime, while TextCNN\/LSTM deliver lower latency. Overall, results confirm that a compact pretrained model with fine-tuning provides clear quality gains on long, nuanced reviews, while traditional approaches remain attractive when speed and simplicity are the priority.<\/jats:p>","DOI":"10.54097\/yn47ye37","type":"journal-article","created":{"date-parts":[[2026,1,31]],"date-time":"2026-01-31T01:14:47Z","timestamp":1769822087000},"page":"332-338","source":"Crossref","is-referenced-by-count":0,"title":["Empirical Study on the Effectiveness of DistilBERT Fine-tuning on IMDb Sentiment Classification Outperforming CNN\/LSTM"],"prefix":"10.54097","volume":"19","author":[{"given":"Shengkai","family":"Yuan","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"32412","published-online":{"date-parts":[[2026,1,29]]},"container-title":["Academic Journal of Science and Technology"],"link":[{"URL":"https:\/\/drpress.org\/ojs\/index.php\/ajst\/article\/download\/33405\/32688","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/drpress.org\/ojs\/index.php\/ajst\/article\/download\/33405\/32688","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,1,31]],"date-time":"2026-01-31T01:14:47Z","timestamp":1769822087000},"score":29.056568,"resource":{"primary":{"URL":"https:\/\/drpress.org\/ojs\/index.php\/ajst\/article\/view\/33405"}},"issued":{"date-parts":[[2026,1,29]]},"references-count":0,"journal-issue":{"issue":"2","published-online":{"date-parts":[[2026,1,29]]}},"URL":"https:\/\/doi.org\/10.54097\/yn47ye37","ISSN":["2771-3032"],"issn-type":[{"value":"2771-3032","type":"electronic"}],"published":{"date-parts":[[2026,1,29]]}},{"indexed":{"date-parts":[[2025,12,4]],"date-time":"2025-12-04T12:51:14Z","timestamp":1764852674947,"version":"3.46.0"},"posted":{"date-parts":[[2025]]},"group-title":"SSRN","reference-count":0,"publisher":"Elsevier BV","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.2139\/ssrn.5677902","type":"posted-content","created":{"date-parts":[[2025,12,4]],"date-time":"2025-12-04T12:47:18Z","timestamp":1764852438000},"source":"Crossref","is-referenced-by-count":0,"title":["Sentiment Analysis on IMDB Movie Reviews using LSTM"],"prefix":"10.2139","author":[{"given":"Nonihal","family":"Choudhary","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"78","deposited":{"date-parts":[[2025,12,4]],"date-time":"2025-12-04T12:47:18Z","timestamp":1764852438000},"score":28.923573,"resource":{"primary":{"URL":"https:\/\/www.ssrn.com\/abstract=5677902"}},"issued":{"date-parts":[[2025]]},"references-count":0,"URL":"https:\/\/doi.org\/10.2139\/ssrn.5677902","published":{"date-parts":[[2025]]},"subtype":"preprint"},{"indexed":{"date-parts":[[2025,9,27]],"date-time":"2025-09-27T00:08:54Z","timestamp":1758931734562,"version":"3.44.0"},"reference-count":0,"publisher":"Inderscience Publishers","issue":"1","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["IJSCC"],"published-print":{"date-parts":[[2025]]},"DOI":"10.1504\/ijscc.2025.10073706","type":"journal-article","created":{"date-parts":[[2025,9,26]],"date-time":"2025-09-26T13:00:19Z","timestamp":1758891619000},"source":"Crossref","is-referenced-by-count":0,"title":["Modelling and control of an intelligent communication system for IMDB sentiment classification"],"prefix":"10.1504","volume":"1","author":[{"given":"Huafen","family":"Yang","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"378","container-title":["International Journal of Systems, Control and Communications"],"language":"en","link":[{"URL":"http:\/\/www.inderscienceonline.com\/doi\/full\/10.1504\/IJSCC.2025.10073706","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,9,26]],"date-time":"2025-09-26T13:00:19Z","timestamp":1758891619000},"score":28.830925,"resource":{"primary":{"URL":"http:\/\/www.inderscience.com\/link.php?id=10073706"}},"issued":{"date-parts":[[2025]]},"references-count":0,"journal-issue":{"issue":"1","published-print":{"date-parts":[[2025]]}},"URL":"https:\/\/doi.org\/10.1504\/ijscc.2025.10073706","ISSN":["1755-9340","1755-9359"],"issn-type":[{"value":"1755-9340","type":"print"},{"value":"1755-9359","type":"electronic"}],"published":{"date-parts":[[2025]]},"article-number":"10073706"},{"indexed":{"date-parts":[[2026,2,28]],"date-time":"2026-02-28T12:09:36Z","timestamp":1772280576256,"version":"3.50.1"},"reference-count":0,"publisher":"Dean & Francis Press","issue":"13","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["JSTECEP"],"abstract":"<jats:p>Pre-trained transformer models are now the most common choices for sentiment analysis and other text classification tasks. However, their large number of parameters and high inference cost make it hard to deploy them in limited resource settings. To solve this problem, several lightweight variants have been introduced, this paper presents a controlled empirical study of four transformerbased models - BERT-base, DistilBERT, TinyBERT, and ALBERT-base - on the IMDb movie review sentiment classification task. All models are fine-tuned under the same conditions. Besides standard metrics, total and persample inference time were measured as well. To better understand stability, the test set is divided into short and long review subsets based on word count and compare model performance across subsets. Results show an accuracy-efficiency trade-off. BERT-base achieves the highest test accuracy (86.3%), followed by ALBERT (85.7%), while DistilBERT is lower (85.2%) but offers about 2 times faster inference. TinyBERT is the fastest but has lower accuracy (81.3%). Across these models, performance on short reviews is higher than on long reviews. The performance drop from short to long texts is more severe for the smallest model, TinyBERT, finding that highly compressed models struggle more with long and complex texts. This paper discusses the implications of findings for selecting sentiment analysis models under different application requirements.<\/jats:p>","DOI":"10.61173\/kjazw478","type":"journal-article","created":{"date-parts":[[2026,2,28]],"date-time":"2026-02-28T10:37:36Z","timestamp":1772275056000},"source":"Crossref","is-referenced-by-count":0,"title":["An Empirical Comparison of BERT and Lightweight Variants for IMDb Sentiment Classification"],"prefix":"10.61173","volume":"3","author":[{"given":"Xuanyu","family":"Wu","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"39891","published-online":{"date-parts":[[2026,2,28]]},"container-title":["Science and Technology of Engineering, Chemistry and Environmental Protection"],"link":[{"URL":"https:\/\/www.deanfrancis.press\/ojs\/index.php\/te\/article\/download\/1648\/TE015462.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/www.deanfrancis.press\/ojs\/index.php\/te\/article\/download\/1648\/TE015462.pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,2,28]],"date-time":"2026-02-28T10:37:36Z","timestamp":1772275056000},"score":28.64318,"resource":{"primary":{"URL":"https:\/\/www.deanfrancis.press\/ojs\/index.php\/te\/article\/view\/1648"}},"issued":{"date-parts":[[2026,2,28]]},"references-count":0,"journal-issue":{"issue":"13","published-online":{"date-parts":[[2026,2,28]]}},"URL":"https:\/\/doi.org\/10.61173\/kjazw478","ISSN":["2960-1339","2959-6157"],"issn-type":[{"value":"2960-1339","type":"electronic"},{"value":"2959-6157","type":"print"}],"published":{"date-parts":[[2026,2,28]]}},{"indexed":{"date-parts":[[2026,6,6]],"date-time":"2026-06-06T16:37:28Z","timestamp":1780763848708,"version":"3.54.1"},"reference-count":0,"publisher":"Elsevier BV","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["SSRN Journal"],"DOI":"10.2139\/ssrn.5103558","type":"journal-article","created":{"date-parts":[[2025,2,21]]