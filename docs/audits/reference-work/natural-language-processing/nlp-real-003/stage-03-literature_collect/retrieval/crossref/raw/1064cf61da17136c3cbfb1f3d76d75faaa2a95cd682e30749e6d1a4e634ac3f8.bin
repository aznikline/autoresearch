ype":"text\/html","content-version":"vor","intended-application":"text-mining"},{"URL":"http:\/\/link.springer.com\/content\/pdf\/10.1007\/s00500-019-04117-w.pdf","content-type":"application\/pdf","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2020,6,3]],"date-time":"2020-06-03T23:21:32Z","timestamp":1591226492000},"score":26.8792,"resource":{"primary":{"URL":"http:\/\/link.springer.com\/10.1007\/s00500-019-04117-w"}},"issued":{"date-parts":[[2019,6,5]]},"references-count":34,"journal-issue":{"issue":"5","published-print":{"date-parts":[[2020,3]]}},"alternative-id":["4117"],"URL":"https:\/\/doi.org\/10.1007\/s00500-019-04117-w","ISSN":["1432-7643","1433-7479"],"issn-type":[{"value":"1432-7643","type":"print"},{"value":"1433-7479","type":"electronic"}],"published":{"date-parts":[[2019,6,5]]},"assertion":[{"value":"5 June 2019","order":1,"name":"first_online","label":"First Online","group":{"name":"ArticleHistory","label":"Article History"}},{"order":1,"name":"Ethics","group":{"name":"EthicsHeading","label":"Compliance with ethical standards"}},{"value":"The authors declare that they have no conflict of interest.","order":2,"name":"Ethics","group":{"name":"EthicsHeading","label":"Conflict of interest"}},{"value":"This article does not contain any studies with human participants or animals performed by any of the authors.","order":3,"name":"Ethics","group":{"name":"EthicsHeading","label":"Ethical approval"}}]},{"indexed":{"date-parts":[[2026,1,27]],"date-time":"2026-01-27T22:22:45Z","timestamp":1769552565995,"version":"3.49.0"},"reference-count":0,"publisher":"SCITEPRESS - Science and and Technology Publications","content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2015]]},"DOI":"10.5220\/0005636001270137","type":"proceedings-article","created":{"date-parts":[[2015,12,2]],"date-time":"2015-12-02T11:41:40Z","timestamp":1449056500000},"page":"127-137","source":"Crossref","is-referenced-by-count":12,"title":["Markov Chain based Method for In-Domain and Cross-Domain Sentiment Classification"],"prefix":"10.5220","author":[{"given":"Giacomo","family":"Domeniconi","sequence":"first","affiliation":[{"name":"Universit\u00e0 degli Studi di Bologna, Italy"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Gianluca","family":"Moro","sequence":"first","affiliation":[{"name":"Universit\u00e0 degli Studi di Bologna, Italy"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Andrea","family":"Pagliarani","sequence":"first","affiliation":[{"name":"Universit\u00e0 degli Studi di Bologna, Italy"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Roberto","family":"Pasolini","sequence":"first","affiliation":[{"name":"Universit\u00e0 degli Studi di Bologna, Italy"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"3171","event":{"name":"7th International Conference on Knowledge Discovery and Information Retrieval","location":"Lisbon, Portugal","start":{"date-parts":[[2015,11,12]]},"end":{"date-parts":[[2015,11,14]]}},"container-title":["Proceedings of the 7th International Joint Conference on Knowledge Discovery, Knowledge Engineering and Knowledge Management"],"original-title":["Markov Chain based Method for In-Domain and Cross-Domain Sentiment Classification"],"deposited":{"date-parts":[[2015,12,2]],"date-time":"2015-12-02T11:42:04Z","timestamp":1449056524000},"score":26.83603,"resource":{"primary":{"URL":"http:\/\/www.scitepress.org\/DigitalLibrary\/Link.aspx?doi=10.5220\/0005636001270137"}},"subtitle":[""],"issued":{"date-parts":[[2015]]},"references-count":0,"URL":"https:\/\/doi.org\/10.5220\/0005636001270137","published":{"date-parts":[[2015]]}},{"indexed":{"date-parts":[[2026,6,18]],"date-time":"2026-06-18T21:52:05Z","timestamp":1781819525072,"version":"3.54.5"},"reference-count":0,"publisher":"Association for the Advancement of Artificial Intelligence (AAAI)","issue":"03","license":[{"start":{"date-parts":[[2020,4,3]],"date-time":"2020-04-03T00:00:00Z","timestamp":1585872000000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/www.aaai.org"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["AAAI"],"abstract":"<jats:p>Existing domain adaptation methods on visual sentiment classification typically are investigated under the single-source scenario, where the knowledge learned from a source domain of sufficient labeled data is transferred to the target domain of loosely labeled or unlabeled data. However, in practice, data from a single source domain usually have a limited volume and can hardly cover the characteristics of the target domain. In this paper, we propose a novel multi-source domain adaptation (MDA) method, termed Multi-source Sentiment Generative Adversarial Network (MSGAN), for visual sentiment classification. To handle data from multiple source domains, it learns to find a unified sentiment latent space where data from both the source and target domains share a similar distribution. This is achieved via cycle consistent adversarial learning in an end-to-end manner. Extensive experiments conducted on four benchmark datasets demonstrate that MSGAN significantly outperforms the state-of-the-art MDA approaches for visual sentiment classification.<\/jats:p>","DOI":"10.1609\/aaai.v34i03.5651","type":"journal-article","created":{"date-parts":[[2020,6,29]],"date-time":"2020-06-29T19:57:33Z","timestamp":1593460653000},"page":"2661-2668","source":"Crossref","is-referenced-by-count":52,"title":["Multi-Source Domain Adaptation for Visual Sentiment Classification"],"prefix":"10.1609","volume":"34","author":[{"given":"Chuang","family":"Lin","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Sicheng","family":"Zhao","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Lei","family":"Meng","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Tat-Seng","family":"Chua","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"9382","published-online":{"date-parts":[[2020,4,3]]},"container-title":["Proceedings of the AAAI Conference on Artificial Intelligence"],"link":[{"URL":"https:\/\/ojs.aaai.org\/index.php\/AAAI\/article\/download\/5651\/5507","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/ojs.aaai.org\/index.php\/AAAI\/article\/download\/5651\/5507","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2022,11,3]],"date-time":"2022-11-03T23:48:56Z","timestamp":1667519336000},"score":26.816256,"resource":{"primary":{"URL":"https:\/\/ojs.aaai.org\/index.php\/AAAI\/article\/view\/5651"}},"issued":{"date-parts":[[2020,4,3]]},"references-count":0,"journal-issue":{"issue":"03","published-online":{"date-parts":[[2020,6,15]]}},"URL":"https:\/\/doi.org\/10.1609\/aaai.v34i03.5651","ISSN":["2374-3468","2159-5399"],"issn-type":[{"value":"2374-3468","type":"electronic"},{"value":"2159-5399","type":"print"}],"published":{"date-parts":[[2020,4,3]]}},{"indexed":{"date-parts":[[2026,5,21]],"date-time":"2026-05-21T18:01:04Z","timestamp":1779386464072,"version":"3.53.1"},"reference-count":0,"publisher":"Institute of Electrical and Electronics Engineers (IEEE)","content-domain":{"domain":[]},"published-print":{"date-parts":[[2024,12,8]]},"DOI":"10.1109\/tgrs.2024.3516522\/v2\/review1","type":"peer-review","created":{"date-parts":[[2025,10,21]],"date-time":"2025-10-21T22:56:06Z","timestamp":1761087366000},"source":"Crossref","is-referenced-by-count":0,"title":["Review for \"Enhancing Remote Sensing Scene Classification With Hy-MSDA: A Hybrid CNN-Transformer for Multisource Domain Adaptation\""],"prefix":"10.1109","member":"263","review":{"type":"referee-report"