ce-count":0,"publisher":"Impact of Genomic Variation on Function (IGVF) Data Administration and Coordination Center","content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2025,9,24]]},"DOI":"10.65695\/igvfds2239vazl","type":"dataset","created":{"date-parts":[[2026,2,9]],"date-time":"2026-02-09T05:55:39Z","timestamp":1770616539000},"source":"Crossref","is-referenced-by-count":0,"title":["IGVFDS2239VAZL"],"prefix":"10.65695","author":[{"name":"Ali Mortazavi, UCI","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"55224","container-title":["IGVF Datasets"],"deposited":{"date-parts":[[2026,2,9]],"date-time":"2026-02-09T05:58:21Z","timestamp":1770616701000},"score":24.151436,"resource":{"primary":{"URL":"https:\/\/data.igvf.org\/IGVFDS2239VAZL\/"}},"issued":{"date-parts":[[2025,9,24]]},"references-count":0,"URL":"https:\/\/doi.org\/10.65695\/igvfds2239vazl","published":{"date-parts":[[2025,9,24]]}},{"indexed":{"date-parts":[[2022,12,4]],"date-time":"2022-12-04T06:05:46Z","timestamp":1670133946050},"reference-count":0,"publisher":"International Journal for Research in Applied Science and Engineering Technology (IJRASET)","issue":"12","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["IJRASET"],"abstract":"<jats:p>Abstract: Sentiment analysis is an artificial intelligence branch that focuses on expressing human emotions and opinions in the sense of data. We try to focus on our sentiment analysis work on the Stanford University-provided IMDB movie review database in this post. We look at the expression of emotions to determine whether a movie review is positive or negative, then standardize and use these features to train multiple label classifiers to identify movie reviews on the right label. Since there were no solid framework structures in a study of random jargon movies, a standardized N-gram approach was used. In addition, a comparison of the various categories' methods was conducted in order to determine the best classifier for our domain query. Our process, which employs separation techniques, has an accuracy of 83 percent.<\/jats:p>","DOI":"10.22214\/ijraset.2022.47795","type":"journal-article","created":{"date-parts":[[2022,12,3]],"date-time":"2022-12-03T10:25:43Z","timestamp":1670063143000},"page":"36-42","source":"Crossref","is-referenced-by-count":0,"title":["Sentiment Analysis of IMDb Movie Reviews"],"prefix":"10.22214","volume":"10","author":[{"given":"Avi","family":"Ajmera","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"9476","published-online":{"date-parts":[[2022,12,31]]},"container-title":["International Journal for Research in Applied Science and Engineering Technology"],"deposited":{"date-parts":[[2022,12,3]],"date-time":"2022-12-03T10:25:49Z","timestamp":1670063149000},"score":24.137012,"resource":{"primary":{"URL":"https:\/\/www.ijraset.com\/best-journal\/sentiment-analysis-of-imdb-movie-reviews"}},"issued":{"date-parts":[[2022,12,31]]},"references-count":0,"journal-issue":{"issue":"12","published-online":{"date-parts":[[2022,12,31]]}},"URL":"https:\/\/doi.org\/10.22214\/ijraset.2022.47795","ISSN":["2321-9653"],"issn-type":[{"value":"2321-9653","type":"electronic"}],"published":{"date-parts":[[2022,12,31]]}},{"institution":[{"name":"Stanford University"}],"indexed":{"date-parts":[[2026,2,10]],"date-time":"2026-02-10T18:04:12Z","timestamp":1770746652569,"version":"3.49.0"},"description":"8 cube mouse F1 hybrid plate 019 67H with gastrocnemius tissue","reference-count":0,"publisher":"Impact of Genomic Variation on Function (IGVF) Data Administration and Coordination Center","content-domain":{"domain":[],"crossmark-restriction":false},"published-print":{"date-parts":[[2025,9,24]]},"DOI":"10.65695\/igvfds6328bdbq","type":"dataset","created":{"date-parts":[[2026,2,10]],"date-time":"2026-02-10T05:55:36Z","timestamp":1770702936000},"source":"Cros