.10084052","type":"proceedings-article","created":{"date-parts":[[2023,4,4]],"date-time":"2023-04-04T20:20:25Z","timestamp":1680639625000},"page":"626-631","source":"Crossref","is-referenced-by-count":12,"title":["Sentiment Analysis on Amazon Product Reviews using LSTM and Naive Bayes"],"prefix":"10.1109","author":[{"given":"Marella Sai","family":"Meghana","sequence":"first","affiliation":[{"name":"V.R.Siddhartha Engineering College,Dept. of CSE,Vijayawada,India"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Davuluru","family":"Abhijith","sequence":"additional","affiliation":[{"name":"V.R.Siddhartha Engineering College,Dept. of CSE,Vijayawada,India"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Shaik","family":"Aysha","sequence":"additional","affiliation":[{"name":"V.R.Siddhartha Engineering College,Dept. of CSE,Vijayawada,India"}],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Praveen Kumar","family":"Kollu","sequence":"additional","affiliation":[{"name":"V.R.Siddhartha Engineering College,Dept. of CSE,Vijayawada,India"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"263","reference":[{"key":"ref1","doi-asserted-by":"publisher","DOI":"10.1186\/s40537-015-0015-2"},{"key":"ref2","doi-asserted-by":"publisher","DOI":"10.1109\/icaccs48705.2020.9074312"},{"key":"ref3","doi-asserted-by":"publisher","DOI":"10.1109\/access.2019.2909919"},{"key":"ref4","volume-title":"NLP: Sentiment Analysis Using LSTM, Analytics Vidhya","year":"2022"},{"key":"ref5","doi-asserted-by":"publisher","DOI":"10.1109\/kse.2019.8919368"},{"key":"ref6","doi-asserted-by":"publisher","DOI":"10.1109\/tencon.2009.5396056"},{"key":"ref7","doi-asserted-by":"publisher","DOI":"10.1109\/access.2020.3042312"},{"key":"ref8","doi-asserted-by":"publisher","DOI":"10.1109\/access.2022.3165621"},{"key":"ref9","doi-asserted-by":"publisher","DOI":"10.1109\/iccis49240.2020.9257657"},{"key":"ref10","doi-asserted-by":"publisher","DOI":"10.1109\/ngct.2016.7877399"},{"key":"ref11","doi-asserted-by":"publisher","DOI":"10.1109\/access.2019.2961100"},{"key":"ref12","doi-asserted-by":"publisher","DOI":"10.1109\/access.2020.2969854"},{"key":"ref13","doi-asserted-by":"publisher","DOI":"10.36548\/jucct.2022.3.008"},{"key":"ref14","doi-asserted-by":"publisher","DOI":"10.1088\/1757-899x\/263\/4\/042090"},{"key":"ref15","volume-title":"Amazon reviews","author":"Jain","year":"2021"}],"event":{"name":"2023 7th International Conference on Computing Methodologies and Communication (ICCMC)","location":"Erode, India","start":{"date-parts":[[2023,2,23]]},"end":{"date-parts":[[2023,2,25]]}},"container-title":["2023 7th International Conference on Computing Methodologies and Communication (ICCMC)"],"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx7\/10083318\/10083503\/10084052.pdf?arnumber=10084052","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2024,2,13]],"date-time":"2024-02-13T19:09:28Z","timestamp":1707851368000},"score":34.926914,"resource":{"primary":{"URL":"https:\/\/ieeexplore.ieee.org\/document\/10084052\/"}},"issued":{"date-parts":[[2023,2,23]]},"references-count":15,"URL":"https:\/\/doi.org\/10.1109\/iccmc56507.2023.10084052","published":{"date-parts":[[2023,2,23]]}},{"indexed":{"date-parts":[[2026,2,28]],"date-time":"2026-02-28T09:38:05Z","timestamp":1772271485699,"version":"3.50.1"},"reference-count":0,"publisher":"PeerJ","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.7717\/peerj-cs.3272\/supp-3","type":"component","created":{"date-parts":[[2025,10,30]],"date-time":"2025-10-30T08:31:51Z","timestamp":1761813111000},"source":"Crossref","is-referenced-by-count":0,"title":["Supplemental Information 3: Implementing Naive Bayes Classification."],"prefix":"10.7717","member":"4443","deposited":{"date-parts":[[2025,10,30]],"date-time":"2025-10-30T08:31:54Z","timestamp":1761813114000},"score":34.67527,"resource":{"primary":{"URL":"https:\/\/peerj.com\/articles\/cs-3272\/supp-3"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.3272\/supp-3","relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.3272","asserted-by":"object"}]}},{"indexed":{"date-parts":[[2025,10,13]],"date-time":"2025-10-13T08:12:55Z","timestamp":1760343175383,"version":"build-2065373602"},"reference-count":0,"publisher":"Universitas Putra Indonesia YPTK Padang","license":[{"start":{"date-parts":[[2025,7,3]],"date-time":"2025-07-03T00:00:00Z","timestamp":1751500800000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["komtekinfo"],"abstract":"<jats:p>This research focuses on sentiment classification of Indonesian-language tweets related to mobile service providers by integrating Support Vector Machine (SVM) and Term Frequency-Inverse Document Frequency (TF-IDF) as the main text representation method. The dataset was sourced from Twitter API and public collections, then went through preprocessing, feature extraction, model training, and performance evaluation phases. The SVM model utilizing TF-IDF exhibited perfect evaluation metrics\u2014100% in accuracy, precision, recall, and F1-score\u2014on the test set, indicating excellent proficiency in detecting both positive and negative sentiments. Nevertheless, such flawless results should be interpreted carefully, as they may suggest limited data diversity. This study contributes to the advancement of sentiment analysis techniques for short and informal Indonesian-language texts on social media platforms.<\/jats:p>","DOI":"10.35134\/komtekinfo.v12i2.642","type":"journal-article","created":{"date-parts":[[2025,10,13]],"date-time":"2025-10-13T07:27:46Z","timestamp":1760340466000},"page":"115-123","source":"Crossref","is-referenced-by-count":0,"title":["Tweet Sentiment Classification Towards Mobile Services Using Naive Bayes and Support Vector Machine"],"prefix":"10.35134","author":[{"given":"Izza Syahri","family":"Muharram","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"family":"Muhammad Faisal","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"20373","published-online":{"date-parts":[[2025,7,3]]},"container-title":["Jurnal KomtekInfo"],"link":[{"URL":"https:\/\/jkomtekinfo.org\/ojs\/index.php\/komtekinfo\/article\/download\/642\/254","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/jkomtekinfo.org\/ojs\/index.php\/komtekinfo\/article\/download\/642\/254","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,10,13]],"date-time":"2025-10-13T07:28:33Z","timestamp":1760340513000},"score":34.555447,"resource":{"primary":{"URL":"https:\/\/jkomtekinfo.org\/ojs\/index.php\/komtekinfo\/article\/view\/642"}},"issued":{"date-parts":[[2025,7,3]]},"references-count":0,"URL":"https:\/\/doi.org\/10.35134\/komtekinfo.v12i2.642","ISSN":["2502-8758","2356-0010"],"issn-type":[{"value":"2502-8758","type":"electronic"},{"value":"2356-0010","type":"print"}],"published":{"date-parts":[[2025,7,3]]}},{"institution":[{"name":"Research Square"}],"indexed":{"date-parts":[[2024,9,20]],"date-time":"2024-09-20T16:54:09Z","timestamp":1726851249558},"posted":{"date-parts":[[2022,5,9]]},"group-title":"In Review","reference-count":0,"publisher":"Research Square Platform LLC","license":[{"start":{"date-parts":[[2022,5,9]],"date-time":"2022-05-09T00:00:00Z","timestamp":1652054400000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0\/"}],"content-domain":{"domain":[],"crossmark-restriction":false},"accepted":{"date-parts":[[2022,5,6]]},"abstract":"<jats:title>Abstract<\/jats:title>\n        <jats:p>Sentiment analysis has emerged as a powerful method to extract polarization of opinion from text. A vast number of prominent sentiment analysis methods can be categorized into rule-based method, lexicon-based method, machine learning method, and deep learning, and ontology-based method. An increasing interest toward sentiment analysis is motivated, among others, by some successful use cases of sentiment analysis in several domains and availability of enormous data as the result of big data explosion in the past ten years. The objective of this study is to identify some latest study reports that represent various trends of sentiment analysis. We implemented sentiment analysis for Arabic tweets, we applied SVM and Naive Bayes algorithms.<\/jats:p>","DOI":"10.21203\/rs.3.rs-1631367\/v1","type":"posted-content","created":{"date-parts":[[2022,5,9]],"date-time":"2022-05-09T15:29:48Z","timestamp":1652110188000},"source":"Crossref","is-referenced-by-count":2,"title":["SVM and Naive Bayes for Sentiment Analysis in Arabic"],"prefix":"10.21203","author":[{"given":"Ahmed","family":"Mohamed","sequence":"first","affiliation":[{"name":"Cairo University"}],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"8761","link":[{"URL":"https:\/\/www.researchsquare.com\/article\/rs-1631367\/v1","content-type":"text\/html","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/www.researchsquare.com\/article\/rs-1631367\/v1.html","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2022,5,9]],"date-time":"2022-05-09T15:29:55Z","timestamp":1652110195000},"score":34.17826,"resource":{"primary":{"URL":"https:\/\/www.researchsquare.com\/article\/rs-1631367\/v1"}},"issued":{"date-parts":[[2022,5,9]]},"references-count":0,"URL":"https:\/\/doi.org\/10.21203\/rs.3.rs-1631367\/v1","published":{"date-parts":[[2022,5,9]]},"subtype":"preprint"},{"indexed":{"date-parts":[[2023,4,25]],"date-time":"2023-04-25T04:38:55Z","timestamp":1682397535923},"description":"Rescognito Funder Information Checklist: The Comparison of Sentiment Analysis of Moon Knight Movie Reviews between Multinomial Naive Bayes and Support Vector Machine","reference-count":0,"publisher":"Rescognito, Inc.","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.37473\/fic\/10.15408\/aism.v6i1.26045","type":"component","created":{"date-parts":[[2023,4,24]],"date-time":"2023-04-24T16:05:30Z","timestamp":1682352330000},"source":"Crossref","is-referenced-by-count":0,"title":["The Comparison of Sentiment Analysis of Moon Knight Movie Reviews between Multinomial Naive Bayes and Support Vector Machine"],"prefix":"10.37473","member":"23793","deposited":{"date-parts":[[2023,4,24]],"date-time":"2023-04-24T16:05:30Z","timestamp":1682352330000},"score":34.11683,"resource":{"primary":{"URL":"https:\/\/rescognito.com\/fic\/10.15408\/aism.v6i1.26045"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.37473\/fic\/10.15408\/aism.v6i1.26045"},{"indexed":{"date-parts":[[2026,2,28]],"date-time":"2026-02-28T04:34:36Z","timestamp":1772253276017,"version":"3.50.1"},"description":"Rescognito Data Availability Checklist: The Comparison of Sentiment Analysis of Moon Knight Movie Reviews between Multinomial Naive Bayes and Support Vector Machine","reference-count":0,"publisher":"Rescognito, Inc.","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.37473\/dac\/10.15408\/aism.v6i1.26045","type":"component","created":{"date-parts":[[2023,4,24]],"date-time":"2023-04-24T12:09:01Z","timestamp":1682338141000},"source":"Crossref","is-referenced-by-count":0,"title":["The Comparison of Sentiment Analysis of Moon Knight Movie Reviews between Multinomial Naive Bayes and Support Vector Machine"],"prefix":"10.37473","member":"23793","deposited":{"date-parts":[[2023,4,24]],"date-time":"2023-04-24T12:09:01Z","timestamp":1682338141000},"score":34.05054,"resource":{"primary":{"URL":"https:\/\/rescognito.com\/dac\/10.15408\/aism.v6i1.26045"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.37473\/dac\/10.15408\/aism.v6i1.26045","relation":{"is-component-of":[{"id-type":"doi","id":"10.15408\/aism.v6i1.26045","asserted-by":"object"}]}},{"indexed":{"date-parts":[[2025,9,16]],"date-time":"2025-09-16T16:36:47Z","timestamp":1758040607714,"version":"3.44.0"},"reference-count":0,"publisher":"LPPM STMIK Royal","issue":"3","content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["JURTEKSI"],"abstract":"<jats:p>Analisis sentimen adalah proses mengidentifikasi dan mengklasifikasikan opini dalam teks menjadi kategori tertentu seperti positif, negatif, atau netral. Penelitian ini bertujuan untuk menganalisis sentimen ulasan produk pada platform e-commerce menggunakan algoritma Naive Bayes. Dataset ulasan produk diambil dari Kaggle, terdiri dari ribuan ulasan dengan label sentimen. Metodologi mencakup tahap preprocessing teks, ekstraksi fitur menggunakan teknik TF-IDF, dan penerapan algoritma Naive Bayes untuk klasifikasi sentimen. Hasil penelitian menunjukkan bahwa algoritma Naive Bayes memberikan akurasi sebesar 94%, membuktikan kemampuannya dalam analisis sentimen dengan dataset teks pendek<\/jats:p>","DOI":"10.33330\/jurteksi.v11i3.3637","type":"journal-article","created":{"date-parts":[[2025,9,11]],"date-time":"2025-09-11T08:47:37Z","timestamp":1757580457000},"page":"457-462","source":"Crossref","is-referenced-by-count":0,"title":["SENTIMENT ANALYSIS  USING NAIVE BAYES  ALGORITHM  CASE  STUDY ON AMAZON  E-COMMERCE  PRODUCT  REVIEWS"],"prefix":"10.33330","volume":"11","author":[{"given":"Erik","family":"Rahman","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Namora","family":"Namora","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Lukman","family":"Anas","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"18931","published-online":{"date-parts":[[2025,6,28]]},"container-title":["JURTEKSI (jurnal Teknologi dan Sistem Informasi)"],"link":[{"URL":"https:\/\/jurnal.stmikroyal.ac.id\/index.php\/jurteksi\/article\/download\/3637\/1672","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/jurnal.stmikroyal.ac.id\/index.php\/jurteksi\/article\/download\/3637\/1672","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,9,11]],"date-time":"2025-09-11T08:47:41Z","timestamp":1757580461000},"score":34.02472,"resource":{"primary":{"URL":"https:\/\/jurnal.stmikroyal.ac.id\/index.php\/jurteksi\/article\/view\/3637"}},"issued":{"date-parts":[[2025,6,28]]},"references-count":0,"journal-issue":{"issue":"3","published-online":{"date-parts":[[2025,6,19]]}},"URL":"https:\/\/doi.org\/10.33330\/jurteksi.v11i3.3637","ISSN":["2550-0201","2407-1811"],"issn-type":[{"type":"electronic","value":"2550-0201"},{"type":"print","value":"2407-1811"}],"published":{"date-parts":[[2025,6,28]]}},{"indexed":{"date-parts":[[2026,2,28]],"date-time":"2026-02-28T09:31:29Z","timestamp":1772271089944,"version":"3.50.1"},"reference-count":0,"publisher":"PeerJ","content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.7717\/peerj-cs.2011\/supp-6","type":"component","created":{"date-parts":[[2024,4,30]],"date-time":"2024-04-30T04:34:13Z","timestamp":1714451653000},"source":"Crossref","is-referenced-by-count":0,"title":["Supplemental Information 6: The IMDB dataset is a sentiment classification task dataset used for sentiment analysis. It consists of sentences extracted from movie reviews"],"prefix":"10.7717","member":"4443","deposited":{"date-parts":[[2024,4,30]],"date-time":"2024-04-30T04:34:20Z","timestamp":1714451660000},"score":33.994278,"resource":{"primary":{"URL":"https:\/\/peerj.com\/articles\/cs-2011\/supp-6"}},"issued":{"date-parts":[[null]]},"references-count":0,"URL":"https:\/\/doi.org\/10.7717\/peerj-cs.2011\/supp-6","relation":{"is-component-of":[{"id-type":"doi","id":"10.7717\/peerj-cs.2011","asserted-by":"object"}]}},{"indexed":{"date-parts":[[2025,12,30]],"date-time":"2025-12-30T07:06:50Z","timestamp":1767078410367,"version":"3.48.0"},"posted":{"date-parts":[[2025,1,21]]},"reference-count":0,"publisher":"Universitas Muhammadiyah Sidoarjo","license":[{"start":{"date-parts":[[2025,1,21]],"date-time":"2025-01-21T00:00:00Z","timestamp":1737417600000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.21070\/ups.6978","type":"posted-content","created":{"date-parts":[[2025,12,30]],"date-time":"2025-12-30T07:03:22Z","timestamp":1767078202000},"source":"Crossref","is-referenced-by-count":0,"title":["Sentiment Analysis of Tantan Application Users: A Performance Comparison Between Naive Bayes and SVM"],"prefix":"10.21070","author":[{"given":"Serlindha Tri","family":"Andini","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-0826-3441","authenticated-orcid":false,"given":"Ade","family":"Eviyanti","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"8674","deposited":{"date-parts":[[2025,12,30]],"date-time":"2025-12-30T07:03:22Z","timestamp":1767078202000},"score":33.524746,"resource":{"primary":{"URL":"https:\/\/archive.umsida.ac.id\/index.php\/archive\/preprint\/view\/6978\/version\/6971"}},"subtitle":["Analisis Sentimen Pengguna Aplikasi Tantan: Perbandingan Kinerja Metode Naive Bayes dan SVM"],"issued":{"date-parts":[[2025,1,21]]},"references-count":0,"URL":"https:\/\/doi.org\/10.21070\/ups.6978","published":{"date-parts":[[2025,1,21]]},"subtype":"preprint"},{"indexed":{"date-parts":[[2026,5,29]],"date-time":"2026-05-29T10:14:00Z","timestamp":1780049640725,"version":"3.53.1"},"reference-count":0,"publisher":"Jurnal Informatika, Teknologi dan Sains Universitas Teknologi Sumbawa","issue":"1","license":[{"start":{"date-parts":[[2026,2,28]],"date-time":"2026-02-28T00:00:00Z","timestamp":1772236800000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["JINTEKS"],"abstract":"<jats:p>Analisis sentimen merupakan pendekatan dalam penambangan teks untuk mengelompokkan opini pengguna berdasarkan data teks. Internet Movie Database (IMDb) menyediakan ulasan film dalam jumlah besar yang dapat dimanfaatkan untuk analisis sentimen berbasis pembelajaran mesin. Penelitian ini bertujuan untuk membandingkan kinerja algoritma Naive Bayes dan Logistic Regression dalam mengklasifikasikan sentimen ulasan film IMDb. Dataset yang digunakan terdiri dari 50.000 ulasan film berbahasa Inggris dengan distribusi sentimen positif dan negatif yang seimbang. Data dibagi menjadi data latih dan data uji dengan rasio 80:20. Tahapan penelitian meliputi pra-pemrosesan teks, ekstraksi fitur menggunakan Term Frequency\u2013Inverse Document Frequency (TF\u2013IDF), pembangunan model klasifikasi, dan evaluasi kinerja menggunakan metrik accuracy, precision, recall, dan F1-score. Hasil pengujian menunjukkan bahwa Logistic Regression menghasilkan kinerja lebih baik dengan akurasi rata-rata sebesar 89,37%, sedangkan Naive Bayes mencapai 86,15%. Perbedaan kinerja tersebut diuji menggunakan paired sample t-test berbasis 10-fold cross validation dan menunjukkan hasil yang signifikan secara statistik (p &lt; 0,05). Keunggulan Logistic Regression secara teknis berkaitan dengan kemampuannya memodelkan hubungan antar fitur tanpa asumsi independensi, yang umum terjadi pada representasi teks berbasis TF\u2013IDF berdimensi tinggi. Namun, penelitian ini masih terbatas pada penggunaan TF\u2013IDF dan perbandingan dua algoritma, sehingga diperlukan pengujian lanjutan untuk memastikan konsistensi hasil.<\/jats:p>","DOI":"10.51401\/jinteks.v8i1.7147","type":"journal-article","created":{"date-parts":[[2026,5,29]],"date-time":"2026-05-29T09:53:01Z","timestamp":1780048381000},"page":"363-370","source":"Crossref","is-referenced-by-count":0,"title":["PERBANDINGAN NAIVE BAYES DAN LOGISTIC REGRESSION PADA ANALISIS SENTIMEN ULASAN IMDB"],"prefix":"10.51401","volume":"8","author":[{"given":"Ade","family":"Elvina","sequence":"first","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]},{"given":"Yohanes","family":"Suhari","sequence":"additional","affiliation":[],"role":[{"vocabulary":"crossref","role":"author"}]}],"member":"28741","published-online":{"date-parts":[[2026,2,28]]},"container-title":["Jurnal Informatika Teknologi dan Sains (Jinteks)"],"link":[{"URL":"https:\/\/jurnal.uts.ac.id\/JINTEKS\/article\/download\/7147\/3267","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/jurnal.uts.ac.id\/JINTEKS\/article\/download\/7147\/3267","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,5,29]],"date-time":"2026-05-29T09:53:02Z","timestamp":1780048382000},"score":33.41547,"resource":{"primary":{"URL":"https:\/\/jurnal.uts.ac.id\/JINTEKS\/article\/view\/7147"}},"issued":{"date-parts":[[2026,2,28]]},"references-count":0,"journal-issue":{"issue":"1","published-online":{"date-parts":[[2026,2,13]]}},"URL":"https:\/\/doi.org\/10.51401\/jinteks.v8i1.7147","ISSN":["2686-3359"],"issn-type":[{"value":"2686-3359","type":"electronic"}],"published":{"date-parts":[[2026,2,28]]}},{"indexed":{"date-parts":[[2026,4,30]],"date-time":"2026-04-30T10:58:15Z","timestamp":1777546695182,"version":"3.51.4"},"reference-count":16,"publisher":"IEEE","content-domain":{"domain