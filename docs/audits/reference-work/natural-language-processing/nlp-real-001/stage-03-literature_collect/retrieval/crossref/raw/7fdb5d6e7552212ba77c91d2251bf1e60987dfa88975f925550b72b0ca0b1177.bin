 achieving higher accuracy and better handling of word frequency information in long textual reviews.<\/jats:p>","DOI":"10.36948\/ijfmr.2025.v07i06.60198","type":"journal-article","created":{"date-parts":[[2025,11,16]],"date-time":"2025-11-16T13:49:11Z","timestamp":1763300951000},"source":"Crossref","is-referenced-by-count":0,"title":["IMDb Sentiment Analysis Using Naive Bayes :Multinomial and Bernoulli Models with LaplaceSmoothing and 5-Fold Cross Validation"],"prefix":"10.36948","volume":"7","author":[{"given":"Lija","family":"Mishra","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"23064","published-online":{"date-parts":[[2025,11,13]]},"container-title":["International Journal For Multidisciplinary Research"],"link":[{"URL":"https:\/\/www.ijfmr.com\/papers\/2025\/6\/60198.pdf","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2025,11,16]],"date-time":"2025-11-16T13:49:16Z","timestamp":1763300956000},"score":41.54077,"resource":{"primary":{"URL":"https:\/\/www.ijfmr.com\/research-paper.php?id=60198"}},"issued":{"date-parts":[[2025,11,13]]},"references-count":0,"journal-issue":{"issue":"6","published-online":{"date-parts":[[2025]]}},"URL":"https:\/\/doi.org\/10.36948\/ijfmr.2025.v07i06.60198","ISSN":["2582-2160"],"issn-type":[{"value":"2582-2160","type":"electronic"}],"published":{"date-parts":[[2025,11,13]]},"article-number":"60198"},{"indexed":{"date-parts":[[2025,6,4]],"date-time":"2025-06-04T17:49:26Z","timestamp":1749059366949,"version":"3.28.0"},"reference-count":46,"publisher":"IEEE","license":[{"start":{"date-parts":[[2023,11,10]],"date-time":"2023-11-10T00:00:00Z","timestamp":1699574400000},"content-version":"stm-asf","delay-in-days":0,"URL":"https:\/\/doi.org\/10.15223\/policy-029"},{"start":{"date-parts":[[2023,11,10]],"date-time":"2023-11-10T00:00:00Z","timestamp":1699574400000},"content-version":"stm-asf","delay-in-days":0,"U