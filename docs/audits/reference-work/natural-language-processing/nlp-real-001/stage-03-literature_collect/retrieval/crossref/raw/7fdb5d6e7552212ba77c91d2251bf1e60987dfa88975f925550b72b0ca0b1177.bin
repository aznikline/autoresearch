},{"key":"ref2","doi-asserted-by":"publisher","DOI":"10.1016\/j.asej.2014.04.011"},{"key":"ref1","doi-asserted-by":"publisher","DOI":"10.2200\/S00416ED1V01Y201204HLT016"},{"key":"ref9","doi-asserted-by":"publisher","DOI":"10.1016\/j.eswa.2008.07.035"}],"event":{"name":"2018 2nd International Symposium on Multidisciplinary Studies and Innovative Technologies (ISMSIT)","location":"Ankara","start":{"date-parts":[[2018,10,19]]},"end":{"date-parts":[[2018,10,21]]}},"container-title":["2018 2nd International Symposium on Multidisciplinary Studies and Innovative Technologies (ISMSIT)"],"link":[{"URL":"http:\/\/xplorestaging.ieee.org\/ielx7\/8543123\/8566679\/08567243.pdf?arnumber=8567243","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2022,1,26]],"date-time":"2022-01-26T17:09:08Z","timestamp":1643216948000},"score":33.37829,"resource":{"primary":{"URL":"https:\/\/ieeexplore.ieee.org\/document\/8567243\/"}},"issued":{"date-parts":[[2018,10]]},"references-count":16,"URL":"https:\/\/doi.org\/10.1109\/ismsit.2018.8567243","published":{"date-parts":[[2018,10]]}},{"indexed":{"date-parts":[[2026,1,28]],"date-time":"2026-01-28T01:10:33Z","timestamp":1769562633533,"version":"3.49.0"},"posted":{"date-parts":[[2026,1,27]]},"reference-count":0,"publisher":"Universitas Muhammadiyah Sidoarjo","license":[{"start":{"date-parts":[[2026,1,27]],"date-time":"2026-01-27T00:00:00Z","timestamp":1769472000000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by\/4.0"}],"content-domain":{"domain":[],"crossmark-restriction":false},"DOI":"10.21070\/ups.9887","type":"posted-content","created":{"date-parts":[[2026,1,27]],"date-time":"2026-01-27T11:39:05Z","timestamp":1769513945000},"source":"Crossref","is-referenced-by-count":0,"title":["Sentiment Analysis of Public Reviews of the Brompit Application Using Naive Bayes and SVM Algorithms"],"prefix":"10.21070","author":[{"given":"Egha Arya","family":"Affandi","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"ORCID":"https:\/\/orcid.org\/0000-0002-7736-8052","authenticated-orcid":false,"given":"Sumarno","family":"Sumarno","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"8674","deposited":{"date-parts":[[2026,1,27]],"date-time":"2026-01-27T11:39:05Z","timestamp":1769513945000},"score":33.075954,"resource":{"primary":{"URL":"https:\/\/archive.umsida.ac.id\/index.php\/archive\/preprint\/view\/9887\/version\/9880"}},"subtitle":["Analisis Sentimen Ulasan Masyarakat Aplikasi Brompit Menggunakan Algoritma Naive Bayes dan SVM"],"issued":{"date-parts":[[2026,1,27]]},"references-count":0,"URL":"https:\/\/doi.org\/10.21070\/ups.9887","published":{"date-parts":[[2026,1,27]]},"subtype":"preprint"},{"indexed":{"date-parts":[[2026,1,13]],"date-time":"2026-01-13T06:48:49Z","timestamp":1768286929180,"version":"3.49.0"},"reference-count":0,"publisher":"Komunitas Dosen Indonesia","issue":"2","license":[{"start":{"date-parts":[[2025,12,10]],"date-time":"2025-12-10T00:00:00Z","timestamp":1765324800000},"content-version":"unspecified","delay-in-days":0,"URL":"https:\/\/creativecommons.org\/licenses\/by-sa\/4.0\/"}],"content-domain":{"domain":[],"crossmark-restriction":false},"short-container-title":["bit-Tech"],"abstract":"<jats:p>The rapid development of e-commerce in Indonesia has led to an increase in the number of consumer reviews containing opinions and experiences of using products. In the cosmetic product category, text reviews have an important role in influencing purchasing decisions. However, the large volume of data and the imbalance of sentiment distribution are the main challenges in conducting manual and accurate sentiment analysis. Therefore, an automated approach based on machine learning is needed that is efficient and capable of handling large-scale and unbalanced data. This study aims to analyze the sentiment of reviews of Emina brand cosmetic products on the Tokopedia platform and evaluate the effectiveness of the Multinomial Na\u00efve Bayes algorithm combined with TF-IDF and SMOTE data balancing techniques in classifying positive, neutral, and negative sentiments. The research data was obtained through web scraping of Emina product reviews, resulting in 446,325 review data. The research stages include text preprocessing, rule-based sentiment labeling, feature extraction using TF-IDF, data balancing using SMOTE, and classification modeling with the Na\u00efve Bayes Multinomial algorithm. Model performance evaluation was carried out using accuracy, precision, recall, F1-score, and confusion matrix metrics. The test results showed that the model achieved an accuracy of 94.72% with a stable F1-score value in all sentiment classes, including minority classes, after the implementation of SMOTE. This study proves that the combination of Multinomial Na\u00efve Bayes, TF-IDF, and SMOTE is effective for large-scale analysis of cosmetic product review sentiment and is able to significantly overcome the problem of data imbalance.<\/jats:p>","DOI":"10.32877\/bt.v8i2.3554","type":"journal-article","created":{"date-parts":[[2026,1,12]],"date-time":"2026-01-12T23:34:28Z","timestamp":1768260868000},"page":"2994-3003","source":"Crossref","is-referenced-by-count":0,"title":["Classification of Sentiment of Emina Product Reviews Using the Naive Bayes Algorithm"],"prefix":"10.32877","volume":"8","author":[{"given":"Wiwik","family":"Astriani","sequence":"first","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Otong Saeful","family":"Bachri","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]},{"given":"Bambang","family":"Irawan","sequence":"additional","affiliation":[],"role":[{"role":"author","vocabulary":"crossref"}]}],"member":"18206","published-online":{"date-parts":[[2025,12,10]]},"container-title":["bit-Tech"],"link":[{"URL":"https:\/\/jurnal.kdi.or.id\/index.php\/bt\/article\/download\/3554\/1799","content-type":"application\/pdf","content-version":"vor","intended-application":"text-mining"},{"URL":"https:\/\/jurnal.kdi.or.id\/index.php\/bt\/article\/download\/3554\/1799","content-type":"unspecified","content-version":"vor","intended-application":"similarity-checking"}],"deposited":{"date-parts":[[2026,1,12]],"date-time":"2026-01-12T23:34:29Z","timestamp":1768260869000},"score":32.882046,"resource":{"primary":{"URL":"https:\/\/jurnal.kdi.or.id\/index.php\/bt\/article\/view\/3554"}},"issued":{"date-parts":[[2025,12,10]]},"references-count":0,"journal-issue":{"issue":"2","published-online":{"date-parts":[[2025,12,10]]}},"URL":"https:\/\/doi.org\/10.32877\/bt.v8i2.3554","ISSN":["2622-2728","2622-271X"],"issn-type":[{"value":"2622-2728","type":"electronic"},{"value":"2622-271X","type":"print"}],"published":{"date-parts":[[2025,12,10]]}},{"indexed":{"date-parts":[[2026,3,7]],"date-time":"2026-03-07T18:03:06Z","timestamp":1772906586587,"version":"3.50.1"},"publisher-location":"Cham","reference-count":35,"publisher":"Springer Nature Switzerland","isbn-type":[{"value":"9783031733437","type":"print"},{"value":"9783031733444","type":"electronic"}],"license":[{"start":{"date-parts":[[2024,1,1]],"date-time":"2024-01-01T00:00:00Z","timestamp":1704067200000},"content-version":"tdm","delay-in-days":0,"URL":"https:\/\/www.springernature.com\/gp\/researchers\/text-and-data-mining"},{"start":{"date-parts":[[2024,1,1]],"date-time":"2024-01-01T00:00:00Z","timestamp":1704067200000},"content-version":"vor","delay-in-days":0,"URL":"https:\/\/www.springernature.com\/gp\/researchers\/text-and-data-mining"}],"content-domain":{"domain":["link.springer.com"],"crossmark-restriction":false},"published-print":{"date-parts":[[2024]]},"DOI":"10.1007\/978-3-031-73344-4_23","type":"book-chapter","created":{"date-parts":[[2024,10,15]],"date-time":"2024-10-15T05:01:40Z","timestamp":1728968500000},"p